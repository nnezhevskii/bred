type ScoreBox<T>(value: T)
type Maybe<T> = Just<T>(value: T) | Nothing

type Health = Healthy | Degraded<Int> | Critical(score: Int) | Offline
type Alert = NoAlert | Notify(level: Int, message: String)

type Metrics(latencyMs: Int, errors: Int, staleMinutes: Int)
type ServiceSnapshot(name: String, metrics: Metrics, score: Int, health: Health)
type mut FleetAudit(total: Int, healthy: Int, degraded: Int, critical: Int, offline: Int, bestScore: Int, worstScore: Int)

fun remember<T>(value: T): Maybe<T> {
    return Just<T>(value)
}

fun boxScore<T>(value: T): ScoreBox<T> {
    return ScoreBox<T>(value)
}

fun clampScore(value: Int): Int {
    if (value < 0) {
        return 0
    }

    if (value > 100) {
        return 100
    }

    return value
}

fun scoreOf(metrics: Metrics): Int {
    var score: Int = 100
    score = score - metrics.errors * 18
    score = score - metrics.staleMinutes / 5

    if (metrics.latencyMs > 800) {
        score = score - 35
    }

    if (metrics.latencyMs > 400) {
        score = score - 15
    }

    return clampScore(score)
}

fun classify(metrics: Metrics): Health {
    val score: Int = scoreOf(metrics)

    if (metrics.errors > 8) {
        return Offline
    }

    if (score >= 82) {
        return Healthy
    }

    if (score >= 55) {
        return Degraded(score)
    }

    return Critical(score)
}

fun snapshot(name: String, metrics: Metrics): ServiceSnapshot {
    val score: Int = scoreOf(metrics)
    val health: Health = classify(metrics)
    return ServiceSnapshot(name, metrics, score, health)
}

fun absorb(audit: FleetAudit, service: ServiceSnapshot): FleetAudit {
    val next: FleetAudit = FleetAudit(
        audit.total,
        audit.healthy,
        audit.degraded,
        audit.critical,
        audit.offline,
        audit.bestScore,
        audit.worstScore
    )

    next.total = next.total + 1

    if (service.score > next.bestScore) {
        next.bestScore = service.score
    }

    if (service.score < next.worstScore) {
        next.worstScore = service.score
    }

    when (service.health) {
        Healthy -> {
            next.healthy = next.healthy + 1
        }
        Degraded(score) -> {
            next.degraded = next.degraded + 1
        }
        Critical(score) -> {
            next.critical = next.critical + 1
        }
        Offline -> {
            next.offline = next.offline + 1
        }
    }

    return next
}

fun healthLabel(health: Health): String {
    var label: String = ""

    when (health) {
        Healthy -> {
            label = "HEALTHY"
        }
        Degraded(score) -> {
            label = "DEGRADED(" + intToString(score) + ")"
        }
        Critical(score) -> {
            label = "CRITICAL(" + intToString(score) + ")"
        }
        Offline -> {
            label = "OFFLINE"
        }
    }

    return label
}

fun explain(service: ServiceSnapshot): String {
    return service.name +
        " | status=" + healthLabel(service.health) +
        " | score=" + intToString(service.score) +
        " | latency=" + intToString(service.metrics.latencyMs) + "ms" +
        " | errors=" + intToString(service.metrics.errors)
}

fun chooseAlert(audit: FleetAudit): Alert {
    if (audit.offline > 0) {
        return Notify(3, "offline service blocks deploy")
    }

    if (audit.critical > 0) {
        return Notify(2, "critical service needs attention")
    }

    if (audit.degraded > 1) {
        return Notify(1, "too many degraded services")
    }

    return NoAlert
}

fun printAudit(audit: FleetAudit): Unit {
    println("fleet total=" + intToString(audit.total))
    println("healthy=" + intToString(audit.healthy) + " degraded=" + intToString(audit.degraded))
    println("critical=" + intToString(audit.critical) + " offline=" + intToString(audit.offline))
    println("best score=" + intToString(audit.bestScore) + " worst score=" + intToString(audit.worstScore))
}

fun main(): Unit {
    val edge: ServiceSnapshot = snapshot("edge-api", Metrics(120, 0, 2))
    val search: ServiceSnapshot = snapshot("search-index", Metrics(460, 1, 18))
    val billing: ServiceSnapshot = snapshot("billing-core", Metrics(930, 3, 35))
    val legacy: ServiceSnapshot = snapshot("legacy-sync", Metrics(1000, 10, 90))

    var audit: FleetAudit = FleetAudit(0, 0, 0, 0, 0, 0, 100)
    audit = absorb(audit, edge)
    audit = absorb(audit, search)
    audit = absorb(audit, billing)
    audit = absorb(audit, legacy)

    val bestBox: ScoreBox<Int> = boxScore<Int>(audit.bestScore)
    val checkpoint: Maybe<Int> = remember<Int>(bestBox.value)
    val alert: Alert = chooseAlert(audit)

    println("=== Deployment Health Radar ===")
    println(explain(edge))
    println(explain(search))
    println(explain(billing))
    println(explain(legacy))
    println("--- audit ---")
    printAudit(audit)
    println("boxed best score=" + intToString(bestBox.value))

    when (checkpoint) {
        Just(bestScore) -> {
            println("checkpoint captured for best score=" + intToString(bestScore))
        }
        Nothing -> {
            println("no score checkpoint was captured")
        }
    }

    when (alert) {
        NoAlert -> {
            println("decision: ship it")
        }
        Notify(level, message) -> {
            println("decision: hold deploy and page the owner")
            println("alert level=" + intToString(level))
            println("reason: " + message)
        }
    }
}
