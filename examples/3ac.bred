val boostTable: Int[8] = [7, 13, 17, 19, 23, 29, 31, 37]

type mut Fighter(name: String, skill: Int, hype: Int, entropy: Int, score: Int, risk: Int, active: Boolean)
type Team(title: String, captain: Fighter, totalScore: Int, maxRisk: Int, checksum: Long, heat: Double)
type Report(title: String, leader: Fighter, topScore: Int, danger: Int, elapsed: Long, heat: Double)

typeclass Printable<T> {
    fun show(value: T): String
}

typeclass Ranked<T> {
    fun better(a: T, b: T): Boolean
}

instance Printable<Int> {
    fun show(value: Int): String {
        return intToString(value)
    }
}

instance Printable<Long> {
    fun show(value: Long): String {
        return longToString(value)
    }
}

instance Printable<Double> {
    fun show(value: Double): String {
        return doubleToString(value)
    }
}

instance Printable<Fighter> {
    fun show(fighter: Fighter): String {
        return fighter.name +
            " | skill=" + intToString(fighter.skill) +
            " hype=" + intToString(fighter.hype) +
            " entropy=" + intToString(fighter.entropy) +
            " score=" + intToString(fighter.score) +
            " risk=" + intToString(fighter.risk)
    }
}

instance Printable<Team> {
    fun show(team: Team): String {
        return "TEAM " + team.title +
            " captain=[" + team.captain.name +
            " score=" + intToString(team.captain.score) +
            " risk=" + intToString(team.captain.risk) + "]" +
            " total=" + intToString(team.totalScore) +
            " maxRisk=" + intToString(team.maxRisk) +
            " heat=" + doubleToString(team.heat) +
            " checksum=" + longToString(team.checksum)
    }
}

instance Printable<Report> {
    fun show(report: Report): String {
        return report.title +
            " leader=[" + report.leader.name +
            " score=" + intToString(report.leader.score) +
            " risk=" + intToString(report.leader.risk) + "]" +
            " topScore=" + intToString(report.topScore) +
            " danger=" + intToString(report.danger) +
            " heat=" + doubleToString(report.heat) +
            " elapsedMs=" + longToString(report.elapsed)
    }
}

instance Ranked<Int> {
    fun better(a: Int, b: Int): Boolean {
        return a > b
    }
}

instance Ranked<Fighter> {
    fun better(a: Fighter, b: Fighter): Boolean {
        if (a.score > b.score) {
            return true
        }
        if (a.score == b.score) {
            return a.risk < b.risk
        }
        return false
    }
}

instance Ranked<Team> {
    fun better(a: Team, b: Team): Boolean {
        if (a.totalScore > b.totalScore) {
            return true
        }
        if (a.totalScore == b.totalScore) {
            return a.maxRisk < b.maxRisk
        }
        return false
    }
}

fun boolWord(value: Boolean): String {
    if (value) {
        return "yes"
    }
    return "no"
}

fun absInt(value: Int): Int {
    if (value < 0) {
        return -value
    }
    return value
}

fun riskLabel(risk: Int): String {
    if (risk < 20) {
        return "clean"
    }
    if (risk < 45) {
        return "spicy"
    }
    if (risk < 75) {
        return "danger"
    }
    return "critical"
}

fun printLine(title: String): Unit {
    println("========== " + title + " ==========")
}

fun printValue<T: Printable>(label: String, value: T): Unit {
    println(label + show(value))
}

fun swapIfBetter<T: Ranked>(items: Array<T>, left: Int, right: Int): Unit {
    if (better(items[right], items[left])) {
        val temp: T = items[left]
        items[left] = items[right]
        items[right] = temp
    }
}

fun sortByRank<T: Ranked>(items: Array<T>, size: Int): Unit {
    for (pass in 0 to size) {
        for (i in 0 to size - 1) {
            swapIfBetter(items, i, i + 1)
        }
    }
}

fun renderArray<T: Printable>(items: Array<T>, size: Int): String {
    var text: String = ""

    if (size == 0) {
        return "[]"
    }

    for (i in 0 to size) {
        text = text + "\n  #" + intToString(i + 1) + " " + show(items[i])
    }

    return text
}

fun mkFighter(name: String, baseSkill: Int, hype: Int, seed: Int): Fighter {
    val entropy: Int = random(0, 99)
    val pressure: Int = random(3, 37)
    val score: Int = baseSkill * 9 + hype * 5 + boostTable[seed % 8] + entropy
    val risk: Int = absInt(entropy - hype) + pressure
    val active: Boolean = score > 500 && risk < 95
    return Fighter(name, baseSkill, hype, entropy, score, risk, active)
}

fun mutateFighter(fighter: Fighter, round: Int): Unit {
    val boost: Int = boostTable[round % 8] + random(0, 50)
    fighter.hype = fighter.hype + boost % 17
    fighter.entropy = fighter.entropy + random(0, 23)
    fighter.score = fighter.score + boost + fighter.skill
    fighter.risk = fighter.risk + absInt(fighter.entropy - fighter.hype) % 13
    fighter.active = fighter.score > 520 && fighter.risk < 110
}

fun simulateArena(fighters: Array<Fighter>, size: Int, rounds: Int): Unit {
    for (round in 0 to rounds) {
        for (i in 0 to size) {
            mutateFighter(fighters[i], round + i)
        }
    }
}

fun totalScore(fighters: Array<Fighter>, size: Int): Int {
    var sum: Int = 0
    for (i in 0 to size) {
        val fighter: Fighter = fighters[i]
        sum = sum + fighter.score
    }
    return sum
}

fun maxRisk(fighters: Array<Fighter>, size: Int): Int {
    var risk: Int = 0
    for (i in 0 to size) {
        val fighter: Fighter = fighters[i]
        if (fighter.risk > risk) {
            risk = fighter.risk
        }
    }
    return risk
}

fun averageScore(fighters: Array<Fighter>, size: Int): Double {
    val total: Int = totalScore(fighters, size)
    val risk: Int = maxRisk(fighters, size)

    if (total > 7200 && risk < 65) {
        return 99.95
    }
    if (total > 6600 && risk < 85) {
        return 93.75
    }
    if (total > 6000) {
        return 88.40
    }
    if (total > 5200) {
        return 76.25
    }
    return 61.50
}

fun activeCount(fighters: Array<Fighter>, size: Int): Int {
    var count: Int = 0
    for (i in 0 to size) {
        val fighter: Fighter = fighters[i]
        if (fighter.active) {
            count = count + 1
        }
    }
    return count
}

fun checksum(start: Long, finish: Long, score: Int, risk: Int): Long {
    val elapsed: Long = finish - start
    return elapsed * 7919L + currentTimeMillis()
}

fun buildTeam(title: String, fighters: Array<Fighter>, size: Int, start: Long, finish: Long): Team {
    sortByRank(fighters, size)
    val total: Int = totalScore(fighters, size)
    val risk: Int = maxRisk(fighters, size)
    val heat: Double = averageScore(fighters, size)
    return Team(title, fighters[0], total, risk, checksum(start, finish, total, risk), heat)
}

fun buildReport(title: String, fighters: Array<Fighter>, size: Int, start: Long, finish: Long): Report {
    sortByRank(fighters, size)
    val risk: Int = maxRisk(fighters, size)
    val heat: Double = averageScore(fighters, size)
    val leader: Fighter = fighters[0]
    return Report(title, leader, leader.score, risk, finish - start, heat)
}

fun printScoutTable(fighters: Array<Fighter>, size: Int): Unit {
    println(renderArray(fighters, size))
    println("active fighters: " + intToString(activeCount(fighters, size)) + " / " + intToString(size))
    println("average heat: " + doubleToString(averageScore(fighters, size)))
}

fun printRiskRadar(fighters: Array<Fighter>, size: Int): Unit {
    printLine("risk radar")
    for (i in 0 to size) {
        val fighter: Fighter = fighters[i]
        println(fighter.name + " -> " + riskLabel(fighter.risk) + " active=" + boolWord(fighter.active))
    }
}

fun main(): Unit {
    val started: Long = currentTimeMillis()
    val fighterCount: Int = 8
    val fighters: Array<Fighter>[8]
    val teams: Array<Team>[2]

    fighters[0] = mkFighter("Nikita", 77, 88, 0)
    fighters[1] = mkFighter("Turbo", 71, 93, 1)
    fighters[2] = mkFighter("ByteLord", 82, 65, 2)
    fighters[3] = mkFighter("StackWizard", 69, 73, 3)
    fighters[4] = mkFighter("HeapHunter", 74, 61, 4)
    fighters[5] = mkFighter("NullBender", 79, 58, 5)
    fighters[6] = mkFighter("CacheKing", 83, 75, 6)
    fighters[7] = mkFighter("LatencyKiller", 76, 97, 7)

    printLine("raw generated arena")
    printScoutTable(fighters, fighterCount)

    simulateArena(fighters, fighterCount, 6)
    sortByRank(fighters, fighterCount)

    printLine("post simulation leaderboard")
    printScoutTable(fighters, fighterCount)
    printRiskRadar(fighters, fighterCount)

    val finished: Long = currentTimeMillis()
    val mainTeam: Team = buildTeam("nightly compiler flex squad", fighters, fighterCount, started, finished)
    val report: Report = buildReport("arena report", fighters, fighterCount, started, finished)
    val winner: Fighter = fighters[0]
    val runnerUp: Fighter = fighters[1]

    teams[0] = mainTeam
    teams[1] = Team("mirror squad", runnerUp, mainTeam.totalScore - winner.risk, mainTeam.maxRisk + 7, mainTeam.checksum + 17L, mainTeam.heat + 0.42)
    sortByRank(teams, 2)

    printLine("final artifacts")
    printValue("best team: ", teams[0])
    printValue("report: ", report)
    println("team table:" + renderArray(teams, 2))
    println("flex verdict: " + winner.name + " cooked the arena with " + intToString(winner.score) + " points")
    readInt()
}
