type Person (name: String, age: Int)


typeclass Printable<A> {
    fun toString(a: A): String
}

typeclass Ordered<A> {
    fun less(a: A, b: A): Boolean
}

instance Printable<Int> {
    fun toString(value: Int): String {
        return intToString(value)
    }
}

instance Printable<Person> {
    fun toString(person: Person): String {
        return "name: " + person.name + " age: " + intToString(person.age)
    }
}

instance Ordered<Int> {
    fun less(a: Int, b: Int): Boolean {
        return a < b
    }
}

instance Ordered<Person> {
    fun less(a: Person, b: Person): Boolean {
        return a.age < b.age
    }
}

fun printValue<T: Printable>(value: T) {
    println(toString(value))
}

fun arrayToString<T: Printable>(arr: Array<T>, size: Int): String {
    var buff: String = ""

    if (size == 0) {
        return ""
    }
    if (size == 1) {
        return toString(arr[0])
    }

    for (i in 0 to size - 1) {
        buff = buff + toString(arr[i]) + " "
    }
    buff = buff + toString(arr[size - 1])

    return buff
}

fun bubbleSort<T: Ordered>(a: Array<T>, size: Int) {
    for (i in 0 to size) {
        for (j in 0 to size) {
            if (less(a[i], a[j])) {
                val temp: T = a[j]
                a[j] = a[i]
                a[i] = temp
            }
        }
    }
}

fun doWork<T: Ordered + Printable>(a: Array<T>, size: Int) {
    println("before: ")
    println(arrayToString(a, size))
    bubbleSort(a, size)
    println("After sorting:")
    println(arrayToString(a, size))
}

fun main(): Unit {
    val arrSize: Int = readInt()
    val arr: Array<Person>[1024]

    for (i in 0 to arrSize) {
       arr[i] = Person("AS", random (25, 100))
    }
    doWork(arr, arrSize)
    readInt()
}
