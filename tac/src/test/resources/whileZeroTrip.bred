fun neverRuns(): Int {
    var marker: Int = 99
    while (false) {
        marker = 0
    }
    return marker
}

fun conditionFalseFromStart(bound: Int): Int {
    var acc: Int = 0
    while (bound > 100) {
        acc = acc + 1
    }
    return acc
}

fun main(): Unit {
    var a: Int = neverRuns()
    var b: Int = conditionFalseFromStart(5)
    println(intToString(a) + ":" + intToString(b))
}
