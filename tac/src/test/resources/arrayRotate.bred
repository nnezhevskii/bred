fun rotateLeft(arr: Int[], size: Int): Unit {
    if (size <= 0) {
        return
    }
    var first: Int = arr[0]
    for (i in 0 to size - 1) {
        var next: Int = i + 1
        arr[i] = arr[next]
    }
    arr[size - 1] = first
}

fun main(): Unit {
    val buf: Int[4]
    buf[0] = 10
    buf[1] = 20
    buf[2] = 30
    buf[3] = 40
    rotateLeft(buf, 4)

    println(intToString(buf[0]) + "-" + intToString(buf[3]))
}
