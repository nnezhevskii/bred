fun minIndex(arr: Array<Int>, size: Int): Int {
    if (size == 0) {
        return -1
    }
    var result: Int = 0
    for (i in 1 to size) {
        if (arr[i] < arr[result]) {
            result = i
        }
    }

    return result
}

fun maxIndex(arr: Array<Int>, size: Int): Int {
    if (size == 0) {
        return -1
    }
    var result: Int = 0
    for (i in 1 to size) {
        if (arr[i] > arr[result]) {
            result = i
        }
    }

    return result
}


fun main(): Unit {
    val arraySize: Int = 50
    val arr: Array<Int>[1024]

    for (i in 0 to arraySize) {
        arr[i] = random(-1000, 1000)
    }

    println(intToString(minIndex(arr, arraySize)))
    println(intToString(maxIndex(arr, arraySize)))
}