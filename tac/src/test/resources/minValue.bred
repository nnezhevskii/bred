fun minIndex(arr: Int[], size: Int): Int {
    if (size <= 0) {
        return -1
    }

    var min: Int = 0
    for (i in 1 to size) {
        if (arr[i] < arr[min]) {
            min = i
        }
    }
    return min
}

fun main() {
    val arr: Int[100]
    val size: Int = readInt()
    if (size > 100) {
        println("technical restrictions")
        return
    }
    for (i in 0 to size) {
        arr[i] = random(0, 100)
    }
    val minInd: Int = minIndex(arr, size)
    if (minInd == -1) {
        println("array is empty")
    } else {
        println("min element is " + intToString(arr[minInd]))
    }
}
