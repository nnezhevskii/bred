fun appendInt(buf: String, value: Int): String {
    return buf + intToString(value)
}

fun formatRow(arr: Int[], size: Int): Unit {
    if (size < 0) {
        println("bad size")
        return
    }
    var line: String = ""
    for (i in 0 to size) {
        if (i > 0) {
            line = line + "|"
        }
        line = appendInt(line, arr[i])
    }
    println(line)
}

fun main(): Unit {
    val row: Int[3]
    row[0] = 1
    row[1] = 2
    row[2] = 3
    formatRow(row, 3)
}
